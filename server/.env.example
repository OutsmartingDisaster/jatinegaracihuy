# Local API configuration — copy to .env or set in shell.
# Full local→Cloudflare switching guide: docs/deploy-switching.md

# Database (libSQL-compatible file; on Turso: libsql://...-turso.io)
DB_PATH=data/governance.db

# Spatial file serving allowlist (R2 bucket on Cloudflare)
SPATIAL_DIR_TILES=data/pmtiles
SPATIAL_DIR_PROCESSED=data/processed

# Citizen report photos (R2 presigned upload on Cloudflare)
UPLOAD_DIR=data/uploads

# dev = X-Dev-Admin header guard; access = Cloudflare Access (production)
ADMIN_MODE=dev

# In-memory TTL cache seconds (Workers KV / Cache API on Cloudflare)
CACHE_TTL_SECONDS=60

# CORS origins, comma-separated
CORS_ORIGINS=*
